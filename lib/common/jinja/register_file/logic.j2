// Register file datapath, shared by rf and rf_row (included from their
// rtl/logic.sv.j2, so {{name}} is whichever resource is being rendered).
//
// Owns the register file and everything that knows what the bits mean: the
// CONF write, the per-port AGU address and enable mapping, and the word/bulk
// read and write paths. The top module only wires this to the decoder and the
// AGU array.

// vesyla_template_start module_head
module {{name}}_{{fingerprint}}_logic
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input logic clk,
    input logic rst_n,

    // CONF writes one word of the register file directly.
    input logic  conf_valid,
    input conf_t conf_instr,

    // One AGU per access port: word write, word read, bulk write, bulk read.
    input logic [NUM_AGUS-1:0]                    agu_valid,
    input logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address,

    input  logic [WORD_BITWIDTH-1:0] word_data_in,
    output logic [WORD_BITWIDTH-1:0] word_data_out,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out
);

    // ─────────────────────────────────────────────────────────────────────
    // AGU port mapping
    // ─────────────────────────────────────────────────────────────────────
    // The AGU index is the resource's port number and is part of a contract
    // shared with the SST model and pasm -- do not renumber here alone.
    logic bulk_w_en, bulk_r_en, word_w_en, word_r_en;
    logic [ADDRESS_WIDTH-1:0] word_w_agu, word_r_agu, bulk_w_agu, bulk_r_agu;

    assign word_w_en = agu_valid[0];
    assign word_r_en = agu_valid[1];
    assign bulk_w_en = agu_valid[2];
    assign bulk_r_en = agu_valid[3];

    assign word_w_agu = agu_address[0];
    assign word_r_agu = agu_address[1];
    assign bulk_w_agu = agu_address[2];
    assign bulk_r_agu = agu_address[3];

    logic [WORD_ADDR_WIDTH-1:0] word_w_addr, word_r_addr;

    assign word_w_addr = word_w_agu[WORD_ADDR_WIDTH-1:0];
    assign word_r_addr = word_r_agu[WORD_ADDR_WIDTH-1:0];

    // ─────────────────────────────────────────────────────────────────────
    // Bulk geometry
    // ─────────────────────────────────────────────────────────────────────
    // A bulk access moves one row of WORD_PER_BULK consecutive words, and the
    // bulk address is the row number: the top BULK_ADDR_WIDTH bits of a word
    // address. With BULK_ADDR_WIDTH = 0 the file is a single row (rf_row), every
    // bulk access covers all of it, and the row signals are tied to 0 -- a
    // [BULK_ADDR_WIDTH-1:0] slice would be [-1:0] there.
    localparam int OFFSET_WIDTH  = WORD_ADDR_WIDTH - BULK_ADDR_WIDTH;
    localparam int WORD_PER_BULK = 2**OFFSET_WIDTH;
    localparam int ROW_WIDTH     = (BULK_ADDR_WIDTH > 0) ? BULK_ADDR_WIDTH : 1;

    logic [ROW_WIDTH-1:0] bulk_w_row, bulk_r_row, word_w_row;

    generate
        if (BULK_ADDR_WIDTH > 0) begin : gen_rows
            assign bulk_w_row = bulk_w_agu[BULK_ADDR_WIDTH-1:0];
            assign bulk_r_row = bulk_r_agu[BULK_ADDR_WIDTH-1:0];
            assign word_w_row = word_w_addr[WORD_ADDR_WIDTH-1 -: BULK_ADDR_WIDTH];
        end else begin : gen_single_row
            assign bulk_w_row = '0;
            assign bulk_r_row = '0;
            assign word_w_row = '0;
        end
    endgenerate

    // ─────────────────────────────────────────────────────────────────────
    // Register file
    // ─────────────────────────────────────────────────────────────────────
    logic [RF_DEPTH-1:0][WORD_BITWIDTH-1:0] memory, memory_next;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            memory <= '{default: 0};
{% if static_config %}
            // No reconfiguration: the words the program's CONFs write, from
            // reset.
  {% for entry in static_config.conf %}
            memory[{{ entry.address }}] <= WORD_BITWIDTH'({{ entry.value }});
  {% endfor %}
{% endif %}
        end
        else begin
            memory <= memory_next;
        end
    end

    // One bulk access covers WORD_PER_BULK consecutive words; the bulk vector
    // is sliced by the *word* width, not by how many words it holds.
    logic [WORD_ADDR_WIDTH-1:0] bulk_w_word, bulk_r_word;
    always_comb begin
        memory_next = memory;
        bulk_data_out = '0;
        word_data_out = '0;
        bulk_w_word = '0;
        bulk_r_word = '0;
        if (bulk_w_en) begin
            for (int i=0; i<WORD_PER_BULK; i++) begin
                bulk_w_word = (WORD_ADDR_WIDTH'(bulk_w_row) << OFFSET_WIDTH) | WORD_ADDR_WIDTH'(i);
                memory_next[bulk_w_word] = bulk_data_in[i*WORD_BITWIDTH +:WORD_BITWIDTH];
            end
        end
        // A word write into the row a bulk write is filling this cycle loses.
        if (word_w_en) begin
            if ((!bulk_w_en) || (bulk_w_row != word_w_row)) begin
                memory_next[word_w_addr] = word_data_in;
            end
        end
        if (bulk_r_en) begin
            for (int i=0; i<WORD_PER_BULK; i++) begin
                bulk_r_word = (WORD_ADDR_WIDTH'(bulk_r_row) << OFFSET_WIDTH) | WORD_ADDR_WIDTH'(i);
                bulk_data_out[i*WORD_BITWIDTH +:WORD_BITWIDTH] = memory[bulk_r_word];
            end
        end
        if (word_r_en) begin
            word_data_out = memory[word_r_addr];
        end

        // CONF initialises one word from the instruction stream. It is issued
        // before the AGUs run, so it does not normally coincide with a write
        // above; if it does, the explicit instruction wins.
        if (conf_valid) begin
            memory_next[conf_instr._address] = conf_instr._value;
        end
    end

endmodule
