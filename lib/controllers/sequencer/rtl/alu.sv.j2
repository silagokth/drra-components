// vesyla_template_start module_head
module {{name}}_{{fingerprint}}_alu
import {{name}}_{{fingerprint}}_pkg::*;
{% set calc_mode_bitwidth = (isa.instructions | selectattr('name', 'equalto', 'calc') | map(attribute='segments') | list | first | selectattr('name', 'equalto', 'mode') | list | first).bitwidth %}
// vesyla_template_end module_head
(
    input logic unsigned [SCALAR_REG_WIDTH-1:0] in1,
    input logic unsigned [SCALAR_REG_WIDTH-1:0] in2,
    input logic unsigned [{{calc_mode_bitwidth}}-1:0] mode,
    output logic unsigned [SCALAR_REG_WIDTH-1:0] out
);

  // The scalar registers hold unsigned values (addresses, loop counts and
  // activation bitmasks). The SST reference model (model 2) treats them as
  // unsigned uint32 with modular wrap and no saturation, so the RTL ALU must
  // match. Signed saturation here diverges from the reference -- e.g. it
  // collapses the mask 0x8000 down to 0x7FFF, corrupting ACT mode-2
  // activations that target port 3 of a slot (bit 15 of a register chunk).
  logic unsigned [SCALAR_REG_WIDTH:0] temp_result;

  always_comb begin
    temp_result = 0;
    if (mode == 1)
      temp_result = in1 + in2;
    else if (mode == 2)
      temp_result = in1 - in2;
    else if (mode == 3)
      temp_result = in1 << in2;
    else if (mode == 4)
      temp_result = in1 >> in2;
    else if (mode == 8)
      temp_result = in1 & in2;
    else if (mode == 9)
      temp_result = in1 | in2;
    else if (mode == 10)
      temp_result = ~in1;
    else if (mode == 11)
      temp_result = in1 ^ in2;
    else if (mode == 17)
      temp_result = in1 == in2;
    else if (mode == 18)
      temp_result = in1 != in2;
    else if (mode == 19)
      temp_result = in1 > in2;
    else if (mode == 20)
      temp_result = in1 >= in2;
    else if (mode == 21)
      temp_result = in1 < in2;
    else if (mode == 22)
      temp_result = in1 <= in2;
    else if (mode == 23) begin // addh
      logic [SCALAR_REG_WIDTH/2-1:0] in1_msb, in2_lsb, sum;
      in1_msb = in1[SCALAR_REG_WIDTH-1:SCALAR_REG_WIDTH/2];
      in2_lsb = in2[SCALAR_REG_WIDTH/2-1:0];
      sum = in1_msb + in2_lsb;
      temp_result = {sum, in1[SCALAR_REG_WIDTH/2-1:0]};
    end else if (mode == 32)
      temp_result = in1 && in2;
    else if (mode == 33)
      temp_result = in1 || in2;
    else if (mode == 34)
      temp_result = !in1;
    else
      temp_result = 0; // default case, should not happen

    // Unsigned modular result: keep the low SCALAR_REG_WIDTH bits (wrap on
    // overflow), matching the SST reference model. No signed saturation.
    out = temp_result[SCALAR_REG_WIDTH-1:0];
  end
endmodule
