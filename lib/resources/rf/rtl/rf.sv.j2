// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [FSM_PER_SLOT-1:0] activate_0,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0,
    output logic [WORD_BITWIDTH-1:0] word_data_out_0,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0
);

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    // Instruction decoding signals
    logic instruction_valid;
    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    assign instruction_valid = instr_en_0;
    assign instruction_payload = instr_0[INSTR_PAYLOAD_BITWIDTH-1:0];

    // Decoded instructions
    logic conf_valid;
    conf_t conf_instr;
    logic evt_valid;
    evt_t evt_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    // Per-AGU address and strobe
    logic [NUM_AGUS-1:0] agu_enable;
    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .conf_valid(conf_valid),
      .conf_instr(conf_instr),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // Shared AGU subsystem (lib/common/agu_array): controller + one agu_rtr
    // per port. rf's AGUs are uniform and have no init-address path, so
    // AGU_ADDR_WIDTH and USE_INIT_ADDR both take their defaults.
    agu_array #(
      .NUM_AGUS(NUM_AGUS),
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
    ) agu_array_inst (
      .clk(clk),
      .rst_n(rst_n),

      // Single instruction slot: EVT port is used directly. rf has no init
      // address path, so evt_init_addr is tied off.
      .evt_valid(evt_valid),
      .evt_port(evt_instr._port),
      .evt_init_addr('0),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .activation(activate_0[NUM_AGUS-1:0]),
      .addr_valid(agu_enable),
      .addr(agu_address),
      .done(),
      .is_configured()
    );

    // Datapath. Owns the register file and decodes everything that reaches it.
    {{name}}_{{fingerprint}}_logic logic_inst (
      .clk  (clk),
      .rst_n(rst_n),

      .conf_valid(conf_valid),
      .conf_instr(conf_instr),

      .agu_valid  (agu_enable),
      .agu_address(agu_address),

      .word_data_in (word_data_in_0),
      .word_data_out(word_data_out_0),
      .bulk_data_in (bulk_data_in_0),
      .bulk_data_out(bulk_data_out_0)
    );

endmodule

// Instruction decoder, generated from isa.json (lib/common/jinja/decoder.j2)
{% include "decoder.j2" %}

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
