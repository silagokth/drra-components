{
  "format": {
    "instr_bitwidth": 32,
    "instr_type_bitwidth": 1,
    "instr_opcode_bitwidth": 3,
    "instr_slot_bitwidth": 4
  },
  "instructions": [
    {
      "name": "conf",
      "opcode": 0,
      "instr_type": 1,
      "segments": [
        {
          "name": "option",
          "comment": "Configuration register where the NCC mode will be stored.",
          "bitwidth": 3
        },
        {
          "name": "mode",
          "comment": "NCC mode",
          "bitwidth": 3,
          "verbo_map": [
            {
              "key": 0,
              "val": "idle"
            },
            {
              "key": 1,
              "val": "load_s_a"
            },
            {
              "key": 2,
              "val": "load_s_a2"
            },
            {
              "key": 3,
              "val": "load_s_ab"
            },
            {
              "key": 4,
              "val": "load_s_b"
            },
            {
              "key": 5,
              "val": "cmp"
            }
          ]
        }
      ]
    },
    {
      "name": "evt",
      "opcode": 1,
      "instr_type": 1,
      "segments": [
        {
          "name": "option",
          "comment": "Configuration option.",
          "bitwidth": 2
        },
        {
          "name": "port",
          "comment": "Configure the base event for the timing pattern of either the NCC operation (0) or the reset operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "ncc"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        },
        {
          "name": "init_addr_sd",
          "comment": "Is initial address static or dynamic?",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "s"
            },
            {
              "key": 1,
              "val": "d"
            }
          ]
        },
        {
          "name": "init_addr",
          "comment": "Initial address",
          "bitwidth": 16
        }
      ]
    },
    {
      "name": "rep",
      "opcode": 2,
      "instr_type": 1,
      "segments": [
        {
          "name": "ext",
          "comment": "0 = base (low half), 1 = extension (high MSBs) of iter/step/delay",
          "bitwidth": 1,
          "default_val": 0
        },
        {
          "name": "port",
          "comment": "Configure the repetition operator to target either the NCC operation (0) or the reset operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "ncc"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        },
        {
          "name": "iter",
          "comment": "Number of iterations.",
          "bitwidth": 7
        },
        {
          "name": "step",
          "comment": "Step size between the addresses generated for each iteration. On the NCC port, the address selects a configured NCC mode.",
          "bitwidth": 7,
          "default_val": 1,
          "is_signed": true
        },
        {
          "name": "delay",
          "comment": "Delay between iterations.",
          "bitwidth": 7
        }
      ]
    },
    {
      "name": "trans",
      "opcode": 3,
      "instr_type": 1,
      "segments": [
        {
          "name": "port",
          "comment": "Configure the transition operator to target either the NCC operation (0) or the reset operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "ncc"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        },
        {
          "name": "delay",
          "comment": "Delay before the transition occurs.",
          "bitwidth": 23
        }
      ]
    }
  ]
}
