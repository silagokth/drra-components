// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [FSM_PER_SLOT-1:0] activate_0,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0,
    output logic [WORD_BITWIDTH-1:0] word_data_out_0,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0,
    input  logic clk_1,
    input  logic rst_n_1,
    input  logic instr_en_1,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_1,
    input  logic [FSM_PER_SLOT-1:0] activate_1,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_1,
    output logic [WORD_BITWIDTH-1:0] word_data_out_1,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_1,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_1,
    input  logic clk_2,
    input  logic rst_n_2,
    input  logic instr_en_2,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_2,
    input  logic [FSM_PER_SLOT-1:0] activate_2,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_2,
    output logic [WORD_BITWIDTH-1:0] word_data_out_2,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_2,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_2,
    input  logic clk_3,
    input  logic rst_n_3,
    input  logic instr_en_3,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_3,
    input  logic [FSM_PER_SLOT-1:0] activate_3,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_3,
    output logic [WORD_BITWIDTH-1:0] word_data_out_3,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_3,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_3,
    output logic io_en_in,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_in,
    input  logic [IO_DATA_WIDTH-1:0] io_data_in
);

    // Useless outputs:
    assign word_data_out_0 = 0;
    assign word_data_out_1 = 0;
    assign word_data_out_2 = 0;
    assign word_data_out_3 = 0;
    assign bulk_data_out_0 = 0;
    assign bulk_data_out_2 = 0;
    assign bulk_data_out_3 = 0;

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    // AGU port map.
    //
    // The AGU index is internal to this module. What is fixed is which
    // (slot, port) pair drives each one -- the same pair the SST model's
    // getRelativePortNum() computes and a .pasm `port=` field names. iosram_top
    // carries the IO input direction only, so it has four:
    //
    //   AGU 0  slot 0 port 0  IO in
    //   AGU 1  slot 0 port 2  SRAM write from IO
    //   AGU 2  slot 1 port 2  SRAM write from bulk
    //   AGU 3  slot 1 port 3  SRAM read to bulk
    //
    // The activation map here and the evt_agu lookup below express the same
    // table and must stay in step: configuring one AGU while activating
    // another is silent, and only shows up as a program producing no data.
    logic [NUM_AGUS-1:0] agu_activate;
    assign agu_activate[0] = activate_0[0];
    assign agu_activate[1] = activate_0[2];
    assign agu_activate[2] = activate_1[2];
    assign agu_activate[3] = activate_1[3];

    logic [NUM_AGUS-1:0] agu_valid;
    // Final (init + generated) address; agu_array adds the EVT initial address.
    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address;

    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    logic [$clog2(3)-1:0] instruction_slot;
    logic instruction_valid;
    always_comb begin
      if (!rst_n) begin
        instruction_payload = '0;
        instruction_slot = '0;
        instruction_valid = 1'b0;
      end else begin
        if (instr_en_0) begin
          instruction_payload = instr_0[INSTR_PAYLOAD_BITWIDTH-1:0];
          instruction_slot = 0;
          instruction_valid = 1'b1;
        end else if (instr_en_1) begin
          instruction_payload = instr_1[INSTR_PAYLOAD_BITWIDTH-1:0];
          instruction_slot = 1;
          instruction_valid = 1'b1;
        end else begin
          instruction_payload = '0;
          instruction_slot = '0;
          instruction_valid = 1'b0;
        end
      end
  end

    // Decoded instructions
    logic evt_valid;
    evt_t evt_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // Which AGU this EVT -- and the REP / TRANS instructions following it --
    // configures. Same table as the activation map above.
    //
    // A (slot, port) pair this variant does not implement configures nothing:
    // iosram_top has no IO output path, and previously those ports addressed
    // AGUs that were tied off, so an EVT naming one was ignored. Dropping it
    // here keeps that, rather than letting it land on AGU 0.
    logic [$clog2(NUM_AGUS)-1:0] evt_agu;
    logic                        evt_agu_valid;
    always_comb begin
      evt_agu = '0;
      evt_agu_valid = 1'b0;
      if (instruction_slot == 0) begin
        case (evt_instr._port)
          EVT_PORT_INPUT_BUFFER: begin evt_agu = 0; evt_agu_valid = 1'b1; end
          EVT_PORT_SRAM_WRITE:   begin evt_agu = 1; evt_agu_valid = 1'b1; end
          default: ;
        endcase
      end else begin
        case (evt_instr._port)
          EVT_PORT_SRAM_WRITE: begin evt_agu = 2; evt_agu_valid = 1'b1; end
          EVT_PORT_SRAM_READ:  begin evt_agu = 3; evt_agu_valid = 1'b1; end
          default: ;
        endcase
      end
    end

    // Shared AGU subsystem (lib/common/rtl/agu_array): controller + one agu_rtr
    // per port. AGU 0 addresses the IO port and the rest address the SRAM, so
    // they get individual address widths. iosram uses the EVT init-address
    // path, so USE_INIT_ADDR is set and `addr` is the final address.
    agu_array #(
      .NUM_AGUS(NUM_AGUS),
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .AGU_ADDR_WIDTH('{IO_ADDR_WIDTH, SRAM_ADDR_WIDTH, SRAM_ADDR_WIDTH, SRAM_ADDR_WIDTH}),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
      .USE_INIT_ADDR(1'b1)
    ) agu_array_inst (
      .clk(clk),
      .rst_n(rst_n),

      .evt_valid(evt_valid && evt_agu_valid),
      .evt_port(evt_agu),
      .evt_init_addr(evt_instr._init_addr),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .activation(agu_activate),
      .addr_valid(agu_valid),
      .addr(agu_address),
      .done(),
      .is_configured()
    );

    // Datapath. Owns the SRAM and routes data between it, the IO input port
    // and the bulk port.
    {{name}}_{{fingerprint}}_logic logic_inst (
      .clk(clk),

      .agu_valid  (agu_valid),
      .agu_address(agu_address),

      .bulk_data_in (bulk_data_in_1),
      .bulk_data_out(bulk_data_out_1),

      .io_en_in  (io_en_in),
      .io_addr_in(io_addr_in),
      .io_data_in(io_data_in)
    );

endmodule

// Instruction decoder, generated from isa.json (lib/common/jinja/decoder.j2)
{% include "decoder.j2" %}

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
