// vesyla_template_start package_head
package {{name}}_{{fingerprint}}_pkg;
// vesyla_template_end package_head

  // vesyla_template_start package_macro
  {% include "package.j2" %}
  // vesyla_template_end package_macro

  import agu_rtr_pkg::*;

  parameter int FSM_DELAY_WIDTH = 3;
  parameter int DPU_MODE_WIDTH = 5; // ISA conf._mode
  parameter int DPU_IMMEDIATE_WIDTH = 16; // ISA conf._immediate

  // Configuration registers: NUM_OPTIONS (arch.json), each holding mode +
  // immediate. CONF addresses one with its `option` field and carries that
  // register's whole contents in `mode` + `immediate`; the payload's low bit
  // is left unused.
  parameter int CONF_NUM_REGISTERS = NUM_OPTIONS;
  parameter int CONF_REG_WIDTH     = DPU_MODE_WIDTH + DPU_IMMEDIATE_WIDTH;
  parameter int BITWIDTH = 16;

  // AGU RTR params
  parameter int NUM_AGUS = 2;
  parameter int AGU_DPU_ADDR_WIDTH = (NUM_OPTIONS > 1) ? $clog2(NUM_OPTIONS) : 1;
  parameter int AGU_RST_ADDR_WIDTH = 1;
  parameter int ADDRESS_WIDTH = (AGU_DPU_ADDR_WIDTH > AGU_RST_ADDR_WIDTH) ? AGU_DPU_ADDR_WIDTH : AGU_RST_ADDR_WIDTH;
  parameter int REP_LEVEL_WIDTH = 3;
  parameter int REP_STEP_WIDTH = ADDRESS_WIDTH;
  parameter int TRANS_OPTION_WIDTH = 2;
  // NUMBER_IR/MT/OR, REP_ITER_WIDTH, REP_DELAY_WIDTH and TRANS_DELAY_WIDTH come
  // from this resource's arch.json custom_properties (emitted by package.j2).

  {% include "agu_config.j2" %}
endpackage
