// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input logic clk_0,
    input logic rst_n_0,
    input logic instr_en_0,
    input logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input logic [3:0] activate_0,
    input logic [WORD_BITWIDTH-1:0] word_data_in_0,
    output logic [WORD_BITWIDTH-1:0] word_data_out_0,
    input logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0,
    input logic clk_1,
    input logic rst_n_1,
    input logic instr_en_1,
    input logic [RESOURCE_INSTR_WIDTH-1:0] instr_1,
    input logic [3:0] activate_1,
    input logic [WORD_BITWIDTH-1:0] word_data_in_1,
    output logic [WORD_BITWIDTH-1:0] word_data_out_1,
    input logic [BULK_BITWIDTH-1:0] bulk_data_in_1,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_1
);

  // Useless output
  assign word_data_out_1 = 0;
  assign bulk_data_out_0 = 0;
  assign bulk_data_out_1 = 0;

  logic clk, rst_n;
  assign clk = clk_0;
  assign rst_n = rst_n_0;

  logic [NUM_AGUS-1:0] agu_activate;
  assign agu_activate[0] = activate_0[0];
  assign agu_activate[1] = activate_0[1];

  logic [INSTRUCTION_PAYLOAD_WIDTH-1:0] instruction_payload;
  logic instruction_valid;
  assign instruction_payload = instr_0;
  assign instruction_valid = instr_en_0;

  // Assign inputs
  logic [WORD_BITWIDTH-1:0] in0, in1, out0;
  assign in0 = word_data_in_0;
  assign in1 = word_data_in_1;

  logic [DPU_IMMEDIATE_WIDTH-1:0] immediate;
  logic [     DPU_MODE_WIDTH-1:0] dpu_mode;

  logic [NUM_AGUS-1:0]                    agu_valid;
  logic                                   reset_accumulator;
  assign reset_accumulator = agu_valid[1];

  // Per-AGU address; AGU 0 selects the live configuration below.
  logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address;

  logic conf_valid;
  conf_t conf_instr;
  logic evt_valid;
  evt_t evt_instr;
  logic rep_valid;
  rep_t rep_instr;
  logic trans_valid;
  trans_t trans_instr;

  {{name}}_{{fingerprint}}_decoder decoder_inst (
    .clk(clk),
    .rst_n(rst_n),

    .instruction_valid(instruction_valid),
    .instruction_payload(instruction_payload),

    .conf_valid(conf_valid),
    .conf_instr(conf_instr),
    .evt_valid(evt_valid),
    .evt_instr(evt_instr),
    .rep_valid(rep_valid),
    .rep_instr(rep_instr),
    .trans_valid(trans_valid),
    .trans_instr(trans_instr)
  );

  // Shared AGU subsystem (lib/common/agu_array): controller + one agu_rtr per
  // port. The two AGUs address different things -- AGU 0 walks the mode table,
  // AGU 1 only strobes the accumulator reset -- so they get individual address
  // widths. dpu has no init-address path, so evt_init_addr is tied off.
  agu_array #(
    .NUM_AGUS(NUM_AGUS),
    .ADDRESS_WIDTH(ADDRESS_WIDTH),
    .AGU_ADDR_WIDTH('{AGU_DPU_ADDR_WIDTH, AGU_RST_ADDR_WIDTH}),
    .NUMBER_IR(NUMBER_IR),
    .NUMBER_MT(NUMBER_MT),
    .NUMBER_OR(NUMBER_OR),
    .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
    .REP_ITER_WIDTH(REP_ITER_WIDTH),
    .REP_STEP_WIDTH(REP_STEP_WIDTH),
    .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
  ) agu_array_inst (
    .clk  (clk),
    .rst_n(rst_n),

    // Single instruction slot: EVT port is used directly.
    .evt_valid(evt_valid),
    .evt_port(evt_instr._port),
    .evt_init_addr('0),

    .rep_valid(rep_valid),
    .rep_ext(rep_instr._ext),
    .rep_delay(rep_instr._delay),
    .rep_iter(rep_instr._iter),
    .rep_step(rep_instr._step),

    .trans_valid(trans_valid),
    .trans_delay(trans_instr._delay),

    .activation(agu_activate),
    .addr_valid(agu_valid),
    .addr(agu_address),
    .done(),
    .is_configured()
  );

  // Configuration registers (lib/common/config_controller). CONF writes one
  // register per FSM state, holding {mode, immediate}; the DPU AGU's address
  // selects which one is live. BYPASS_ON_VALID keeps the original behaviour of
  // reading the configuration in the same cycle its address is generated.
  logic [0:0][CONF_REG_WIDTH-1:0] current_config;

  config_controller #(
    .NUM_OPTIONS(CONF_NUM_OPTIONS),
    .REGS_PER_OPTION(1),
    .REG_WIDTH(CONF_REG_WIDTH),
    .SELECT_WIDTH(AGU_DPU_ADDR_WIDTH),
    .BYPASS_ON_VALID(1'b1)
  ) config_inst (
    .clk  (clk),
    .rst_n(rst_n),

    .write_valid (conf_valid),
    .write_option(conf_instr._option),
    .write_reg   ('0),
    // Each field is widened to its declared width so the concatenation is
    // exactly CONF_REG_WIDTH regardless of the ISA's segment sizes.
    .write_data  ({DPU_MODE_WIDTH'(conf_instr._mode),
                   DPU_IMMEDIATE_WIDTH'(conf_instr._immediate)}),

    .select_valid (agu_valid[0]),
    .select_option(agu_address[0][AGU_DPU_ADDR_WIDTH-1:0]),

    .current(current_config)
  );

  assign dpu_mode = current_config[0][CONF_REG_WIDTH-1 -: DPU_MODE_WIDTH];
  // Immediate reads as zero unless the AGU is presenting an address this
  // cycle, matching the previous dpu_mode_selector behaviour.
  assign immediate = agu_valid[0] ? current_config[0][DPU_IMMEDIATE_WIDTH-1:0]
                                  : '0;

  // Calculation logic
  logic accumulator_valid;
  logic signed [BITWIDTH-1:0] acc0, acc0_next;
  logic signed [BITWIDTH-1:0] acc0_current;
  logic signed [BITWIDTH-1:0] adder_in0;
  logic signed [BITWIDTH-1:0] adder_in1;
  logic signed [BITWIDTH-1:0] adder_out;
  logic signed [BITWIDTH-1:0] mult_in0;
  logic signed [BITWIDTH-1:0] mult_in1;
  logic signed [BITWIDTH-1:0] mult_out;

  assign acc0_current = (reset_accumulator | agu_activate[1]) ? '0 : acc0;
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      acc0 <= '0;
      accumulator_valid <= 1'b0;
    end else begin
      acc0 <= acc0_next;
      accumulator_valid <= 1'b1;
    end
  end

  always_comb begin
    out0 = 0;
    adder_in0 = 0;
    adder_in1 = 0;
    mult_in0 = 0;
    mult_in1 = 0;
    acc0_next = 0;

    case (dpu_mode)
      CONF_MODE_ADD: begin
        adder_in0 = in0;
        adder_in1 = in1;
        out0 = adder_out;
      end
      CONF_MODE_MAC: begin
        mult_in0  = in0;
        mult_in1  = in1;
        adder_in0 = mult_out;
        if (accumulator_valid) begin
          adder_in1 = acc0_current;
        end else begin
          adder_in1 = '0;
        end
        acc0_next = adder_out;
        out0 = adder_out;
      end
      CONF_MODE_MULT: begin
        mult_in0 = in0;
        mult_in1 = in1;
        out0 = mult_out;
      end

      default: begin
        out0 = '0;
      end
    endcase
  end

  // in future we will use ChipWare blocks for pipelined and such
  {{name}}_{{fingerprint}}_adder adder_inst (
      .in1(adder_in0),
      .in2(adder_in1),
      .saturate(1'b1),
      .out(adder_out),
      .overflow(), // unused
      .underflow() // unused
  );

  {{name}}_{{fingerprint}}_multiplier mult_inst (
      .in1(mult_in0),
      .in2(mult_in1),
      .saturate(1'b1),
      .out(mult_out),
      .overflow(), // unused
      .underflow() // unused
  );

  // register output
  logic [WORD_BITWIDTH-1:0] out0_reg;
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      out0_reg <= 0;
    end else begin
      out0_reg <= out0;
    end
  end
  assign word_data_out_0 = out0_reg;

endmodule

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail

