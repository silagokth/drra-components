{ "format": {
    "instr_bitwidth": 32,
    "instr_type_bitwidth": 1,
    "instr_opcode_bitwidth": 3,
    "instr_slot_bitwidth": 4
  },
  "instructions": [
    {
      "name": "conf",
      "opcode": 0,
      "instr_type": 1,
      "segments": [
        {
          "name": "option",
          "comment": "Configuration register where the DPU mode will be stored.",
          "bitwidth": 2
        },
        {
          "name": "mode",
          "comment": "DPU mode",
          "bitwidth": 5,
          "verbo_map": [
            {
              "key": 0,
              "val": "idle"
            },
            {
              "key": 1,
              "val": "add"
            },
            {
              "key": 7,
              "val": "mult"
            },
            {
              "key": 10,
              "val": "mac"
            }
          ]
        },
        {
          "name": "immediate",
          "comment": "Immediate value. Stored in the configuration register; no mode consumes it yet.",
          "bitwidth": 16
        }
      ]
    },
    {
      "name": "evt",
      "opcode": 1,
      "instr_type": 1,
      "segments": [
        {
          "name": "port",
          "comment": "Configure the base event for the timing pattern of either the DPU operation (0) or the RST operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "dpu"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        }
      ]
    },
    {
      "name": "rep",
      "opcode": 2,
      "instr_type": 1,
      "segments": [
        {
          "name": "ext",
          "comment": "0 = base (low half), 1 = extension (high MSBs) of iter/step/delay",
          "bitwidth": 1
        },
        {
          "name": "port",
          "comment": "Configure the repetition operator to target either the DPU operation (0) or the RST operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "dpu"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        },
        {
          "name": "iter",
          "comment": "Number of iterations.",
          "bitwidth": 7
        },
        {
          "name": "step",
          "comment": "Step size between the addresses generated for each iteration.",
          "bitwidth": 7,
          "default_val": 1,
          "is_signed": true
        },
        {
          "name": "delay",
          "comment": "Delay between iterations.",
          "bitwidth": 7
        }
      ]
    },
    {
      "name": "trans",
      "opcode": 3,
      "instr_type": 1,
      "segments": [
        {
          "name": "port",
          "comment": "Configure the transition operator to target either the DPU operation (0) or the RST operation (1).",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "dpu"
            },
            {
              "key": 1,
              "val": "rst"
            }
          ]
        },
        {
          "name": "delay",
          "comment": "Delay before the transition occurs.",
          "bitwidth": 23
        }
      ]
    }
  ]
}
