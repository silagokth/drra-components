// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [3:0] activate_0,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0,  // unused
    output logic [WORD_BITWIDTH-1:0] word_data_out_0, // unused
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0
);

    assign word_data_out_0 = '0;

    logic clk, rst_n;
    assign clk   = clk_0;
    assign rst_n = rst_n_0;

    // Two AGUs share the same shape as io: full IR/MT/OR.
    agu_cfg_if #(
        .NUMBER_IR        (NUMBER_IR),
        .NUMBER_MT        (NUMBER_MT),
        .NUMBER_OR        (NUMBER_OR),
        .REP_DELAY_WIDTH  (REP_DELAY_WIDTH),
        .REP_ITER_WIDTH   (REP_ITER_WIDTH),
        .REP_STEP_WIDTH   (REP_STEP_WIDTH),
        .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
        .ADDRESS_WIDTH    (ADDRESS_WIDTH)
    ) agu_configs [NUM_AGUS] ();

    logic [NUM_AGUS-1:0] agu_valid;
    logic [NUM_AGUS-1:0] agu_activate;
    // Slot 0 port 0 -> input AGU (advances the 2-line buffer).
    // Slot 0 port 1 -> offset AGU (drives output enable + lane offset).
    assign agu_activate[0] = activate_0[0];
    assign agu_activate[1] = activate_0[1];

    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address, agu_final_address;
    logic [NUM_AGUS-1:0] agu_done;
    genvar idx;
    generate
      for (idx = 0; idx < NUM_AGUS; idx++)
        assign agu_final_address[idx] = agu_address[idx];
    endgenerate

    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    assign instruction_payload = instr_en_0 ? instr_0[INSTR_PAYLOAD_BITWIDTH-1:0] : '0;
    logic instruction_valid;
    assign instruction_valid = instr_en_0;

    // Instruction decode + unpack feeds the shared agu_controller as plain
    // decoded fields.
    logic evt_valid;
    evt_t evt_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    agu_controller #(
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUM_AGUS(NUM_AGUS),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
    ) controller_inst (
      .clk(clk),
      .rst_n(rst_n),

      // Single instruction slot: EVT port is used directly. The offset AGU's
      // init_addr is the starting lane offset; the input AGU ignores it.
      .evt_valid(evt_valid),
      .evt_port(evt_instr._port),
      .evt_init_addr(evt_instr._init_addr),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .agu_done(agu_done),
      .agu_configs(agu_configs),
      .init_address()
    );

    genvar i;
    generate
      for (i = 0; i < NUM_AGUS; i++) begin : gen_agu
        agu_rtr #(
          .ADDRESS_WIDTH(IO_ADDR_WIDTH),
          .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
          .REP_ITER_WIDTH(REP_ITER_WIDTH),
          .REP_STEP_WIDTH(REP_STEP_WIDTH),
          .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
          .NUMBER_OR(NUMBER_OR),
          .NUMBER_MT(NUMBER_MT),
          .NUMBER_IR(NUMBER_IR)
        ) agu_inst (
          .clk(clk),
          .rst_n(rst_n),
          .enable(1'b1),
          .activation(agu_activate[i]),
          .cfg(agu_configs[i]),
          .addr_valid(agu_valid[i]),
          .addr(agu_address[i]),
          .done(agu_done[i])
        );
      end
    endgenerate

    // ─────────────────────────────────────────────────────────────────────────
    // Two-line buffer + barrel slice.
    //
    // The input AGU's addr_valid gates admission of a new bulk word into the
    // buffer. line_A holds the older row, line_B the newer. The buffer shifts
    // whenever agu_valid[0] is high:
    //
    //     line_A <= line_B
    //     line_B <= bulk_data_in_0
    //
    // The offset is held in offset_reg, which latches the offset AGU's low
    // OFFSET_WIDTH address bits whenever agu_valid[1] is high. Between fires
    // of the offset AGU, offset_reg retains its last value. bulk_data_out_0
    // is registered from the next-state window and offset, avoiding an extra
    // cycle of latency from reading stale state at the clock edge.
    //
    // No prime counter: the program must delay the offset AGU's first fire
    // until two input fires have already happened, otherwise the slice will
    // contain reset state.
    // ─────────────────────────────────────────────────────────────────────────
    logic [BULK_BITWIDTH-1:0]   line_A, line_B;
    logic [BULK_BITWIDTH-1:0]   line_A_next, line_B_next;
    logic [CONCAT_BITWIDTH-1:0] window_next;
    logic [OFFSET_WIDTH-1:0]    offset_reg, offset_next;
    logic [BULK_BITWIDTH-1:0]   bulk_data_out_next;

    always_comb begin
      line_A_next = line_A;
      line_B_next = line_B;
      offset_next = offset_reg;

      if (agu_valid[0]) begin
        line_A_next = line_B;
        line_B_next = bulk_data_in_0;
      end

      if (agu_valid[1]) begin
        offset_next = agu_final_address[1][OFFSET_WIDTH-1:0];
      end

      window_next         = {line_B_next, line_A_next};
      bulk_data_out_next = window_next[offset_next * WORD_BITWIDTH +: BULK_BITWIDTH];
    end

    always_ff @(posedge clk or negedge rst_n) begin
      if (!rst_n) begin
        line_A          <= '0;
        line_B          <= '0;
        offset_reg      <= '0;
        bulk_data_out_0 <= '0;
      end else begin
        line_A          <= line_A_next;
        line_B          <= line_B_next;
        offset_reg      <= offset_next;
        bulk_data_out_0 <= bulk_data_out_next;
      end
    end
endmodule

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
