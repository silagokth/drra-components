// vesyla_template_start module_head
module vpu_alu_wrapper
  import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
  input logic clk,
  input logic rst_n,

  input logic  [WORD_BITWIDTH-1:0] word_in0,
  input logic  [WORD_BITWIDTH-1:0] word_in1,
  input logic  [BULK_BITWIDTH-1:0] bulk_in0,
  input logic  [BULK_BITWIDTH-1:0] bulk_in1,

  input logic [VPU_IMMEDIATE_WIDTH-1:0] immediate,
  input logic [     VPU_MODE_WIDTH-1:0] vpu_mode,

  input  logic                     acc_valid,
  input  logic [BULK_BITWIDTH-1:0] acc_current,
  output logic [BULK_BITWIDTH-1:0] acc_next,

  output logic [WORD_BITWIDTH-1:0] word_out,
  output logic [BULK_BITWIDTH-1:0] bulk_out
);

logic signed [WORD_BITWIDTH-1:0] adder_in0 [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] adder_in1 [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] adder_out [VECTOR_SIZE];
genvar i;
generate
  for (i = 0; i < VECTOR_SIZE; i++) begin : gen_adders
    {{name}}_{{fingerprint}}_adder adder_inst (
        .in1(adder_in0[i]),
        .in2(adder_in1[i]),
        .saturate(1'b1),
        .out(adder_out[i])
    );
  end
endgenerate

logic signed [WORD_BITWIDTH-1:0] mult_in0  [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] mult_in1  [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] mult_out  [VECTOR_SIZE];
generate
  for (i = 0; i < VECTOR_SIZE; i++) begin : gen_multipliers
    {{name}}_{{fingerprint}}_multiplier mult_inst (
        .in1(mult_in0[i]),
        .in2(mult_in1[i]),
        .saturate(1'b1),
        .out(mult_out[i])
    );
  end
endgenerate

logic [WORD_BITWIDTH-1:0] alu_result [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] accu_next  [VECTOR_SIZE];

// ---------------------------------------------------------------------------
// Signed per-lane views of the operands.
//
// `bulk_in0` / `bulk_in1` / `acc_current` are plain `logic [BULK_BITWIDTH-1:0]`
// vectors, so any slice of them is UNSIGNED. Relational operators in
// SystemVerilog are unsigned when either operand is unsigned, which made every
// compare mode below an unsigned compare: max(-5, 0) saw 0xFFFB as 65531 and
// returned -5 instead of 0. ReLU is exactly max_imm(x, 0), so this silently
// turned the fused activation into an identity in RTL while the C++/SST model
// (which works on sign-extended int64) got it right.
//
// Slicing once into explicitly `signed` lane vectors makes every compare, and
// the arithmetic right shifts, signed. The adder/multiplier operand nets were
// already declared signed, so those modes were never affected.
// ---------------------------------------------------------------------------
logic signed [WORD_BITWIDTH-1:0] lane0    [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] lane1    [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] acc_lane [VECTOR_SIZE];
logic signed [WORD_BITWIDTH-1:0] w1_s;
logic signed [WORD_BITWIDTH-1:0] imm_s;

// Shift amounts stay unsigned — a shift distance is a count, not a value.
logic [WORD_BITWIDTH-1:0] w1_u;
logic [WORD_BITWIDTH-1:0] imm_u;
logic [WORD_BITWIDTH-1:0] lane1_u [VECTOR_SIZE];

always_comb begin : comb_operand_slice
  for (int i = 0; i < VECTOR_SIZE; i++) begin
    lane0[i]    = $signed(bulk_in0[i*WORD_BITWIDTH +: WORD_BITWIDTH]);
    lane1[i]    = $signed(bulk_in1[i*WORD_BITWIDTH +: WORD_BITWIDTH]);
    acc_lane[i] = $signed(acc_current[i*WORD_BITWIDTH +: WORD_BITWIDTH]);
    lane1_u[i]  = bulk_in1[i*WORD_BITWIDTH +: WORD_BITWIDTH];
  end
  w1_s  = $signed(word_in1);
  imm_s = $signed(immediate);
  w1_u  = word_in1;
  imm_u = immediate;
end

always_comb begin : comb_calculation
  for (int i = 0; i < VECTOR_SIZE; i++) begin
    adder_in0[i] = '0;
    adder_in1[i] = '0;

    mult_in0[i]  = '0;
    mult_in1[i]  = '0;

    alu_result[i] = '0;
    accu_next[i]  = acc_lane[i];
  end

  case (vpu_mode)
    VPU_MODE_ADD: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        adder_in0[i] = lane0[i];
        adder_in1[i] = w1_s;
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_SUB: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        adder_in0[i] = lane0[i];
        adder_in1[i] = -w1_s;
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_MUL: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        mult_in0[i] = lane0[i];
        mult_in1[i] = w1_s;
        alu_result[i] = mult_out[i];
      end
    end
    VPU_MODE_MAC: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        mult_in0[i]  = lane0[i];
        mult_in1[i]  = w1_s;
        adder_in0[i] = mult_out[i];
        if (acc_valid)
          adder_in1[i] = acc_lane[i];
        else
          adder_in1[i] = '0;
        accu_next[i] = adder_out[i];
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_MIN: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < w1_s) ? lane0[i] : w1_s;
    end
    VPU_MODE_MAX: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > w1_s) ? lane0[i] : w1_s;
    end
    VPU_MODE_LSHIFT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] <<< w1_u;
    end
    VPU_MODE_RSHIFT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] >>> w1_u;
    end
    VPU_MODE_SEQ: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] == w1_s) ? '1 : '0;
    end
    VPU_MODE_SNE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] != w1_s) ? '1 : '0;
    end
    VPU_MODE_SLT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < w1_s) ? '1 : '0;
    end
    VPU_MODE_SLE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] <= w1_s) ? '1 : '0;
    end
    VPU_MODE_SGT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > w1_s) ? '1 : '0;
    end
    VPU_MODE_SGE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] >= w1_s) ? '1 : '0;
    end
    VPU_MODE_AND: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] & w1_s;
    end
    VPU_MODE_OR: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] | w1_s;
    end
    VPU_MODE_XOR: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] ^ w1_s;
    end

    VPU_MODE_VADD: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        adder_in0[i] = lane0[i];
        adder_in1[i] = lane1[i];
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_VSUB: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        adder_in0[i] = lane0[i];
        adder_in1[i] = -lane1[i];
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_VMUL: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        mult_in0[i] = lane0[i];
        mult_in1[i] = lane1[i];
        alu_result[i] = mult_out[i];
      end
    end
    VPU_MODE_VMAC: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        mult_in0[i]  = lane0[i];
        mult_in1[i]  = lane1[i];
        adder_in0[i] = mult_out[i];
        if (acc_valid)
          adder_in1[i] = acc_lane[i];
        else
          adder_in1[i] = '0;
        accu_next[i] = adder_out[i];
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_VMIN: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < lane1[i]) ? lane0[i] : lane1[i];
    end
    VPU_MODE_VMAX: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > lane1[i]) ? lane0[i] : lane1[i];
    end
    VPU_MODE_VLSHIFT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] <<< lane1_u[i];
    end
    VPU_MODE_VRSHIFT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] >>> lane1_u[i];
    end
    VPU_MODE_VSEQ: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] == lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VSNE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] != lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VSLT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VSLE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] <= lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VSGT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VSGE: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] >= lane1[i]) ? '1 : '0;
    end
    VPU_MODE_VAND: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] & lane1[i];
    end
    VPU_MODE_VOR: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] | lane1[i];
    end
    VPU_MODE_VXOR: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] ^ lane1[i];
    end
    VPU_MODE_VNOT: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = ~lane0[i];
    end

    VPU_MODE_ADD_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        adder_in0[i] = lane0[i];
        adder_in1[i] = imm_s;
        alu_result[i] = adder_out[i];
      end
    end
    VPU_MODE_MUL_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++) begin
        mult_in0[i] = lane0[i];
        mult_in1[i] = imm_s;
        alu_result[i] = mult_out[i];
      end
    end
    VPU_MODE_MIN_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < imm_s) ? lane0[i] : imm_s;
    end
    VPU_MODE_MAX_IMM: begin
      // ReLU = max_imm(x, 0). Signed compare (see comb_operand_slice above).
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > imm_s) ? lane0[i] : imm_s;
    end
    VPU_MODE_LSHIFT_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] <<< imm_u;
    end
    VPU_MODE_RSHIFT_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] >>> imm_u;
    end
    VPU_MODE_SEQ_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] == imm_s) ? '1 : '0;
    end
    VPU_MODE_SNE_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] != imm_s) ? '1 : '0;
    end
    VPU_MODE_SLT_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] < imm_s) ? '1 : '0;
    end
    VPU_MODE_SLE_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] <= imm_s) ? '1 : '0;
    end
    VPU_MODE_SGT_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] > imm_s) ? '1 : '0;
    end
    VPU_MODE_SGE_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = (lane0[i] >= imm_s) ? '1 : '0;
    end
    VPU_MODE_AND_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] & imm_s;
    end
    VPU_MODE_OR_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] | imm_s;
    end
    VPU_MODE_XOR_IMM: begin
      for (int i = 0; i < VECTOR_SIZE; i++)
        alu_result[i] = lane0[i] ^ imm_s;
    end

    // NOTE: VPU_MODE_ADD_ACC / SUB_ACC / VADD_ACC / VSUB_ACC deliberately have
    // no case here — they are not implemented in hardware. The SST model makes
    // all four `out.fatal(...)`, so a program that uses one dies loudly in the
    // C++/SST run instead of passing SST and reading back zeros from RTL.
    default: ; // alu_result and accu_next already initialized in loop above
  endcase
end

always_comb begin : comb_output
  word_out = '0;
  for (int i = 0; i < VECTOR_SIZE; i++) begin
    bulk_out[i*WORD_BITWIDTH +: WORD_BITWIDTH] = alu_result[i];
    acc_next[i*WORD_BITWIDTH +: WORD_BITWIDTH] = accu_next[i];
  end
end


endmodule
