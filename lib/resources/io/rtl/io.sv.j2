// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

{# Loop-variable bus contract: must match the sequencer and the cell. #}
{% set num_loop_levels = 3 %}
{% set loop_var_width = 16 %}

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [3:0] activate_0,
    // Loop counters from the sequencer, level d at bits
    // [(d+1)*LOOP_VAR_WIDTH-1 : d*LOOP_VAR_WIDTH]; evt.loop_level picks one.
    input  logic [{{num_loop_levels * loop_var_width}}-1:0] loop_var_bus,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0, // unused
    output logic [WORD_BITWIDTH-1:0] word_data_out_0, // unused
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0,
    output logic io_en_in,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_in,
    input  logic [IO_DATA_WIDTH-1:0] io_data_in,
    output logic io_en_out,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_out,
    output logic [IO_DATA_WIDTH-1:0] io_data_out
);

    // Useless outputs:
    assign word_data_out_0 = 0;

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    agu_cfg_if #(
        .NUMBER_IR        (NUMBER_IR),
        .NUMBER_MT        (NUMBER_MT),
        .NUMBER_OR        (NUMBER_OR),
        .REP_DELAY_WIDTH  (REP_DELAY_WIDTH),
        .REP_ITER_WIDTH   (REP_ITER_WIDTH),
        .REP_STEP_WIDTH   (REP_STEP_WIDTH),
        .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
    ) agu_configs [NUM_AGUS] ();
    logic [NUM_AGUS-1:0] agu_valid;
    logic [NUM_AGUS-1:0] agu_activate;
    assign agu_activate[0] = activate_0[0]; // slot 0 port 0
    assign agu_activate[1] = activate_0[1]; // slot 0 port 1

    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address, agu_final_address;
    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_init_address;
    logic [NUM_AGUS-1:0] agu_done;

    // Offset terms per port, one per nested loop: evt sets term 0, evts
    // appends the rest. Each term is (stride, loop_level); the named counter is
    // sampled off the bus at activation and held for the whole run.
    localparam int LOOP_VAR_WIDTH = {{loop_var_width}};
    localparam int NDIM = {{num_loop_levels}}; // max offset terms per port
    logic [EVTS_STRIDE_BITWIDTH-1:0]    agu_stride  [NUM_AGUS-1:0][NDIM-1:0];
    logic [EVT_LOOP_LEVEL_BITWIDTH-1:0] agu_level   [NUM_AGUS-1:0][NDIM-1:0];
    logic [LOOP_VAR_WIDTH-1:0]          loop_var_q  [NUM_AGUS-1:0][NDIM-1:0];
    logic [$clog2(NDIM+1)-1:0]          agu_nterm   [NUM_AGUS-1:0];

    // High bits of the init address, from evtx.
    logic [EVTX_INIT_ADDR_HIGH_BITWIDTH-1:0] agu_init_high [NUM_AGUS-1:0];

    // Unused terms have stride 0, so summing all NDIM is safe.
    logic [ADDRESS_WIDTH-1:0] agu_offset [NUM_AGUS-1:0];
    always_comb begin
      for (int i = 0; i < NUM_AGUS; i++) begin
        agu_offset[i] = '0;
        for (int t = 0; t < NDIM; t++) begin
          agu_offset[i] += ADDRESS_WIDTH'(agu_stride[i][t] * loop_var_q[i][t]);
        end
      end
    end

    genvar idx;
    generate
      for (idx = 0; idx < NUM_AGUS; idx++)
        assign agu_final_address[idx] = agu_address[idx] + agu_init_address[idx]
             + (ADDRESS_WIDTH'(agu_init_high[idx]) << EVT_INIT_ADDR_BITWIDTH)
             + agu_offset[idx];
    endgenerate

    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    assign instruction_payload = instr_en_0 ? instr_0[INSTR_PAYLOAD_BITWIDTH-1:0] : '0;
    logic instruction_valid;
    assign instruction_valid = instr_en_0;

    logic evt_valid;
    evt_t evt_instr;
    logic evtx_valid;
    evtx_t evtx_instr;
    logic evts_valid;
    evts_t evts_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .evtx_valid(evtx_valid),
      .evtx_instr(evtx_instr),
      .evts_valid(evts_valid),
      .evts_instr(evts_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // evt sets term 0 (clearing the rest), evts appends terms, evtx sets
    // the init-address high bits.
    always_ff @(posedge clk or negedge rst_n) begin
      if (~rst_n) begin
        for (int i = 0; i < NUM_AGUS; i++) begin
          for (int t = 0; t < NDIM; t++) begin
            agu_stride[i][t] <= '0;
            agu_level[i][t]  <= '0;
          end
          agu_nterm[i] <= '0;
          agu_init_high[i] <= '0;
        end
      end else if (evt_valid) begin
        agu_stride[evt_instr._port][0] <= evt_instr._stride;
        agu_level[evt_instr._port][0]  <= evt_instr._loop_level;
        for (int t = 1; t < NDIM; t++) begin
          agu_stride[evt_instr._port][t] <= '0;
          agu_level[evt_instr._port][t]  <= '0;
        end
        agu_nterm[evt_instr._port] <= 1;
      end else if (evts_valid) begin
        agu_stride[evts_instr._port][agu_nterm[evts_instr._port]] <= evts_instr._stride;
        agu_level[evts_instr._port][agu_nterm[evts_instr._port]]  <= evts_instr._loop_level;
        agu_nterm[evts_instr._port] <= agu_nterm[evts_instr._port] + 1;
      end else if (evtx_valid) begin
        agu_init_high[evtx_instr._port] <= evtx_instr._init_addr_high;
      end
    end

    // Sample the counters at activation so every address in this run shares
    // the same offset.
    always_ff @(posedge clk or negedge rst_n) begin
      if (~rst_n) begin
        for (int i = 0; i < NUM_AGUS; i++) begin
          for (int t = 0; t < NDIM; t++) begin
            loop_var_q[i][t] <= '0;
          end
        end
      end else begin
        for (int i = 0; i < NUM_AGUS; i++) begin
          if (agu_activate[i]) begin
            for (int t = 0; t < NDIM; t++) begin
              loop_var_q[i][t] <= loop_var_bus[agu_level[i][t]*LOOP_VAR_WIDTH +: LOOP_VAR_WIDTH];
            end
          end
        end
      end
    end

    agu_controller #(
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUM_AGUS(NUM_AGUS),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
      .EVT_INIT_ADDR_WIDTH(EVT_INIT_ADDR_BITWIDTH)
    ) controller_inst (
      .clk(clk),
      .rst_n(rst_n),

      // Single instruction slot: EVT port is used directly.
      .evt_valid(evt_valid),
      .evt_port(evt_instr._port),
      .evt_init_addr(evt_instr._init_addr),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .agu_done(agu_done),
      .agu_configs(agu_configs),
      .init_address(agu_init_address)
    );

    genvar i;
    generate
      for (i = 0; i < NUM_AGUS; i++) begin : gen_agu
        agu_rtr #(
          .ADDRESS_WIDTH(IO_ADDR_WIDTH),
          .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
          .REP_ITER_WIDTH(REP_ITER_WIDTH),
          .REP_STEP_WIDTH(REP_STEP_WIDTH),
          .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
          .NUMBER_OR(NUMBER_OR),
          .NUMBER_MT(NUMBER_MT),
          .NUMBER_IR(NUMBER_IR)
        ) agu_inst (
          .clk(clk),
          .rst_n(rst_n),
          .enable(1'b1),
          .activation(agu_activate[i]),
          .cfg(agu_configs[i]),
          .addr_valid(agu_valid[i]),
          .addr(agu_address[i]),
          .done(agu_done[i])
        );
      end
    endgenerate

    // Input and output paths drive independent ports, so allow them to run
    // simultaneously instead of muxing through a shared register. The previous
    // if/else-if chain (and the shared `selected_data` register) silently
    // dropped one path when both AGUs were valid in the same cycle.
    always_comb begin
        // Defaults: all ports inactive.
        io_en_in        = 1'b0;
        io_addr_in      = '0;
        bulk_data_out_0 = '0;
        io_en_out       = 1'b0;
        io_addr_out     = '0;
        io_data_out     = '0;

        // Input path (slot 0 port 0 -> input buffer): forward IO read data to
        // the bulk output port.
        if (agu_valid[0]) begin
            io_en_in        = 1'b1;
            io_addr_in      = agu_final_address[0];
            bulk_data_out_0 = io_data_in;
        end

        // Output path (slot 0 port 1 -> output buffer): forward bulk input
        // data to the IO write port.
        if (agu_valid[1]) begin
            io_en_out   = 1'b1;
            io_addr_out = agu_final_address[1];
            io_data_out = bulk_data_in_0;
        end
    end
endmodule

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
