// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [3:0] activate_0,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0, // unused
    output logic [WORD_BITWIDTH-1:0] word_data_out_0, // unused
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0,
    output logic io_en_in,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_in,
    input  logic [IO_DATA_WIDTH-1:0] io_data_in,
    output logic io_en_out,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_out,
    output logic [IO_DATA_WIDTH-1:0] io_data_out
);

    // Useless outputs:
    assign word_data_out_0 = 0;

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    logic [NUM_AGUS-1:0] agu_valid;
    logic [NUM_AGUS-1:0] agu_activate;
    assign agu_activate[0] = activate_0[0]; // slot 0 port 0
    assign agu_activate[1] = activate_0[1]; // slot 0 port 1

    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_final_address;

    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    assign instruction_payload = instr_en_0 ? instr_0[INSTR_PAYLOAD_BITWIDTH-1:0] : '0;
    logic instruction_valid;
    assign instruction_valid = instr_en_0;

    logic evt_valid;
    evt_t evt_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // Shared AGU subsystem (lib/common/agu_array): controller + one agu_rtr
    // per port. io's AGUs are uniform and all present; it does use the EVT
    // init-address path, so USE_INIT_ADDR is set and `addr` is the final
    // (init + generated) address.
    agu_array #(
      .NUM_AGUS(NUM_AGUS),
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
      .USE_INIT_ADDR(1'b1)
    ) agu_array_inst (
      .clk(clk),
      .rst_n(rst_n),

      // Single instruction slot: EVT port is used directly.
      .evt_valid(evt_valid),
      .evt_port(evt_instr._port),
      .evt_init_addr(evt_instr._init_addr),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .activation(agu_activate),
      .addr_valid(agu_valid),
      .addr(agu_final_address),
      .done(),
      .is_configured()
    );

    // Input and output paths drive independent ports, so allow them to run
    // simultaneously instead of muxing through a shared register. The previous
    // if/else-if chain (and the shared `selected_data` register) silently
    // dropped one path when both AGUs were valid in the same cycle.
    always_comb begin
        // Defaults: all ports inactive.
        io_en_in        = 1'b0;
        io_addr_in      = '0;
        bulk_data_out_0 = '0;
        io_en_out       = 1'b0;
        io_addr_out     = '0;
        io_data_out     = '0;

        // Input path (slot 0 port 0 -> input buffer): forward IO read data to
        // the bulk output port.
        if (agu_valid[0]) begin
            io_en_in        = 1'b1;
            io_addr_in      = agu_final_address[0];
            bulk_data_out_0 = io_data_in;
        end

        // Output path (slot 0 port 1 -> output buffer): forward bulk input
        // data to the IO write port.
        if (agu_valid[1]) begin
            io_en_out   = 1'b1;
            io_addr_out = agu_final_address[1];
            io_data_out = bulk_data_in_0;
        end
    end
endmodule

// Instruction decoder, generated from isa.json (lib/common/jinja/decoder.j2)
{% include "decoder.j2" %}

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
