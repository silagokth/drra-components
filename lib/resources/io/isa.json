{
  "format": {
    "instr_bitwidth": 32,
    "instr_type_bitwidth": 1,
    "instr_opcode_bitwidth": 3,
    "instr_slot_bitwidth": 4
  },
  "instructions": [
    {
      "name": "conf",
      "opcode": 0,
      "instr_type": 1,
      "segments": [
        {
          "name": "wr_mask",
          "comment": "Words of a row an output buffer write stores; bit n is word n. Holds until the next conf; all ones after reset.",
          "bitwidth": 16,
          "default_val": 65535
        }
      ]
    },
    {
      "name": "evt",
      "opcode": 1,
      "instr_type": 1,
      "segments": [
        {
          "name": "option",
          "comment": "Configuration option where the DSU mode will be stored. There are 4 options per port.",
          "bitwidth": 2
        },
        {
          "name": "port",
          "comment": "The port number",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "input_buffer",
              "comment": "address generation for input buffer (cannot be active simultaneously with the output buffer)"
            },
            {
              "key": 1,
              "val": "output_buffer",
              "comment": "address generation for output buffer (cannot be active simultaneously with the input buffer)"
            }
          ]
        },
        {
          "name": "init_addr_sd",
          "comment": "Is initial address static or dynamic?",
          "bitwidth": 1,
          "verbo_map": [
            {
              "key": 0,
              "val": "s"
            },
            {
              "key": 1,
              "val": "d"
            }
          ]
        },
        {
          "name": "init_addr",
          "comment": "Initial address",
          "bitwidth": 16
        }
      ]
    },
    {
      "name": "rep",
      "opcode": 2,
      "instr_type": 1,
      "ext": true,
      "segments": [
        {
          "name": "ext",
          "comment": "0 = base (low half), 1 = extension (high MSBs) of iter/step/delay",
          "bitwidth": 1,
          "default_val": 0
        },
        {
          "name": "iter",
          "comment": "Number of iterations.",
          "bitwidth": 7
        },
        {
          "name": "step",
          "comment": "Step size between iterations.",
          "bitwidth": 7,
          "default_val": 1,
          "is_signed": true
        },
        {
          "name": "delay",
          "comment": "Delay between iterations.",
          "bitwidth": 7
        },
        {
          "name": "lane",
          "comment": "0: an outer rep opening a level, its step for every lane. k > 0: the step of lane k at the last outer level opened, which opens no level.",
          "bitwidth": 2
        }
      ]
    },
    {
      "name": "trans",
      "opcode": 3,
      "instr_type": 1,
      "segments": [
        {
          "name": "delay",
          "comment": "Delay before the transition occurs.",
          "bitwidth": 23
        }
      ]
    }
  ]
}
