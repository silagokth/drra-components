// iosram_both datapath.
//
// Owns the SRAM and everything that knows what the bits mean: the AGU
// addresses become IO and SRAM addresses, and data is routed between the IO
// ports, the bulk port and the SRAM. The top module only wires this to the
// decoder and the AGU array.
//
// iosram_both carries both IO directions, so it has six AGUs:
//
//   AGU 0  IO in                  (slot 0 port 0)
//   AGU 1  IO out                 (slot 0 port 1)
//   AGU 2  SRAM write from IO     (slot 0 port 2)
//   AGU 3  SRAM read to IO        (slot 0 port 3)
//   AGU 4  SRAM write from bulk   (slot 1 port 2)
//   AGU 5  SRAM read to bulk      (slot 1 port 3)

// vesyla_template_start module_head
module {{name}}_{{fingerprint}}_logic
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input logic clk,

    input logic [NUM_AGUS-1:0]                    agu_valid,
    input logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address,

    input  logic [BULK_BITWIDTH-1:0] bulk_data_in,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out,

    output logic                     io_en_in,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_in,
    input  logic [IO_DATA_WIDTH-1:0] io_data_in,

    output logic                     io_en_out,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_out,
    output logic [IO_DATA_WIDTH-1:0] io_data_out
);

    // merge the IO writing and normal writing to SRAM, IO has higher priority.
    // merge the writing and reading, writing has higher priority.
    logic [SRAM_ADDR_WIDTH-1:0] sram_in_addr;
    logic sram_in_en;
    logic [BULK_BITWIDTH-1:0] sram_in_data;
    logic [SRAM_ADDR_WIDTH-1:0] sram_out_addr;
    logic sram_out_en;
    logic [BULK_BITWIDTH-1:0] sram_out_data;

    // input ports
    always_comb begin
        // SRAM IN (AGU 2 - SLOT 0 PORT 2)
        if (agu_valid[2]) begin
            sram_in_en = 1;
            sram_in_addr = agu_address[2];
            sram_in_data = io_data_in;
        end
        // BULK IN (AGU 4 - SLOT 1 PORT 2)
        else if (agu_valid[4]) begin
            sram_in_en = 1;
            sram_in_addr = agu_address[4];
            sram_in_data = bulk_data_in;
        end
        else begin
            sram_in_en = 0;
            sram_in_addr = 0;
            sram_in_data = 0;
        end
    end

    // output ports
    always_comb begin
        // SRAM OUT (AGU 3 - SLOT 0 PORT 3)
        if (agu_valid[3]) begin
            sram_out_en = 1;
            sram_out_addr = agu_address[3];
            io_data_out = sram_out_data;
            bulk_data_out = 0;
        end
        // BULK OUT (AGU 5 - SLOT 1 PORT 3)
        else if (agu_valid[5]) begin
            sram_out_en = 1;
            sram_out_addr = agu_address[5];
            io_data_out = 0;
            bulk_data_out = sram_out_data;
        end
        else begin
            sram_out_en = 0;
            sram_out_addr = 0;
            io_data_out = 0;
            bulk_data_out = 0;
        end
    end

    // IO IN (AGU 0 - SLOT 0 PORT 0)
    assign io_en_in = agu_valid[0];
    assign io_addr_in = agu_address[0];

    // IO OUT (AGU 1 - SLOT 0 PORT 1)
    assign io_en_out = agu_valid[1];
    assign io_addr_out = agu_address[1];

    sram #(
        .DEPTH(DEPTH),
        .WIDTH(WIDTH)
    ) sram_inst (
        .clk(clk),
        .enable_a_n(~sram_in_en),
        .enable_b_n(~sram_out_en),
        .write_enable_a_n(~sram_in_en),
        .write_enable_b_n(1'b1),
        .address_a(sram_in_addr),
        .address_b(sram_out_addr),
        .data_a(sram_in_data),
        .data_b('0),
        .q_a(),
        .q_b(sram_out_data)
    );

endmodule
