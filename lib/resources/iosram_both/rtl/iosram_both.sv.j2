// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

{# Loop-variable bus contract: must match the sequencer and the cell. #}
{% set num_loop_levels = 3 %}
{% set loop_var_width = 16 %}

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [3:0] activate_0,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_0,
    output logic [WORD_BITWIDTH-1:0] word_data_out_0,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_0,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_0,
    input  logic clk_1,
    input  logic rst_n_1,
    input  logic instr_en_1,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_1,
    input  logic [3:0] activate_1,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_1,
    output logic [WORD_BITWIDTH-1:0] word_data_out_1,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_1,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_1,
    input  logic clk_2,
    input  logic rst_n_2,
    input  logic instr_en_2,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_2,
    input  logic [3:0] activate_2,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_2,
    output logic [WORD_BITWIDTH-1:0] word_data_out_2,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_2,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_2,
    input  logic clk_3,
    input  logic rst_n_3,
    input  logic instr_en_3,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_3,
    input  logic [3:0] activate_3,
    input  logic [WORD_BITWIDTH-1:0] word_data_in_3,
    output logic [WORD_BITWIDTH-1:0] word_data_out_3,
    input  logic [BULK_BITWIDTH-1:0] bulk_data_in_3,
    output logic [BULK_BITWIDTH-1:0] bulk_data_out_3,
    output logic io_en_in,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_in,
    input  logic [IO_DATA_WIDTH-1:0] io_data_in,
    output logic io_en_out,
    output logic [IO_ADDR_WIDTH-1:0] io_addr_out,
    output logic [IO_DATA_WIDTH-1:0] io_data_out,
    // Loop counters from the sequencer, level d at bits
    // [(d+1)*LOOP_VAR_WIDTH-1 : d*LOOP_VAR_WIDTH]; evt.loop_level picks one.
    input  logic [{{num_loop_levels * loop_var_width}}-1:0] loop_var_bus
);

    // Useless outputs:
    assign word_data_out_0 = 0;
    assign word_data_out_1 = 0;
    assign word_data_out_2 = 0;
    assign word_data_out_3 = 0;
    assign bulk_data_out_0 = 0;
    assign bulk_data_out_2 = 0;
    assign bulk_data_out_3 = 0;

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    agu_cfg_if #(
        .NUMBER_IR        (NUMBER_IR),
        .NUMBER_MT        (NUMBER_MT),
        .NUMBER_OR        (NUMBER_OR),
        .REP_DELAY_WIDTH  (REP_DELAY_WIDTH),
        .REP_ITER_WIDTH   (REP_ITER_WIDTH),
        .REP_STEP_WIDTH   (REP_STEP_WIDTH),
        .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
    ) agu_configs [NUM_AGUS] ();
    logic [NUM_AGUS-1:0] agu_valid;
    logic [NUM_AGUS-1:0] agu_activate;
    assign agu_activate[0] = activate_0[0]; // slot 0 port 0
    assign agu_activate[1] = activate_0[1]; // slot 0 port 1
    assign agu_activate[2] = activate_0[2]; // slot 0 port 2
    assign agu_activate[3] = activate_0[3]; // slot 0 port 3
    assign agu_activate[4] = activate_1[2]; // slot 1 port 2
    assign agu_activate[5] = activate_1[3]; // slot 1 port 3

    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address, agu_final_address;
    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_init_address;
    logic [NUM_AGUS-1:0] agu_done;

    // Offset terms per port, one per nested loop: evt sets term 0, evts
    // appends the rest. Each term is (stride, loop_level); the named counter is
    // sampled off the bus at activation and held for the whole run.
    localparam int LOOP_VAR_WIDTH = {{loop_var_width}};
    localparam int NDIM = {{num_loop_levels}}; // max offset terms per port
    logic [EVTS_STRIDE_BITWIDTH-1:0]    agu_stride  [NUM_AGUS-1:0][NDIM-1:0];
    logic [EVT_LOOP_LEVEL_BITWIDTH-1:0] agu_level   [NUM_AGUS-1:0][NDIM-1:0];
    logic [LOOP_VAR_WIDTH-1:0]          loop_var_q  [NUM_AGUS-1:0][NDIM-1:0];
    logic [$clog2(NDIM+1)-1:0]          agu_nterm   [NUM_AGUS-1:0];

    // High bits of the init address, from evtx.
    logic [EVTX_INIT_ADDR_HIGH_BITWIDTH-1:0] agu_init_high [NUM_AGUS-1:0];

    // Unused terms have stride 0, so summing all NDIM is safe.
    logic [ADDRESS_WIDTH-1:0] agu_offset [NUM_AGUS-1:0];
    always_comb begin
      for (int i = 0; i < NUM_AGUS; i++) begin
        agu_offset[i] = '0;
        for (int t = 0; t < NDIM; t++) begin
          agu_offset[i] += ADDRESS_WIDTH'(agu_stride[i][t] * loop_var_q[i][t]);
        end
      end
    end

    genvar idx;
    generate
      for (idx = 0; idx < NUM_AGUS; idx++)
        assign agu_final_address[idx] = agu_address[idx] + agu_init_address[idx]
             + (ADDRESS_WIDTH'(agu_init_high[idx]) << EVT_INIT_ADDR_BITWIDTH)
             + agu_offset[idx];
    endgenerate

    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    logic [$clog2(3)-1:0] instruction_slot;
    logic instruction_valid;
    always_comb begin
      if (!rst_n) begin
        instruction_payload = '0;
        instruction_slot = '0;
        instruction_valid = 1'b0;
      end else begin
        if (instr_en_0) begin
          instruction_payload = instr_0[INSTR_PAYLOAD_BITWIDTH-1:0];
          instruction_slot = 0;
          instruction_valid = 1'b1;
        end else if (instr_en_1) begin
          instruction_payload = instr_1[INSTR_PAYLOAD_BITWIDTH-1:0];
          instruction_slot = 1;
          instruction_valid = 1'b1;
        end else begin
          instruction_payload = '0;
          instruction_slot = '0;
          instruction_valid = 1'b0;
        end
      end
    end

    logic evt_valid;
    evt_t evt_instr;
    logic evtx_valid;
    evtx_t evtx_instr;
    logic evts_valid;
    evts_t evts_instr;
    logic rep_valid;
    rep_t rep_instr;
    logic trans_valid;
    trans_t trans_instr;

    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .evtx_valid(evtx_valid),
      .evtx_instr(evtx_instr),
      .evts_valid(evts_valid),
      .evts_instr(evts_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // evt sets term 0 (clearing the rest), evts appends terms, evtx sets
    // the init-address high bits.
    // Same slot->AGU mapping as evt_port: slot>0 targets the upper AGU group.
    logic [$clog2(NUM_AGUS)-1:0] evt_agu_index;
    assign evt_agu_index = (instruction_slot == 0) ? evt_instr._port
                                                   : evt_instr._port + 2;
    logic [$clog2(NUM_AGUS)-1:0] evts_agu_index;
    assign evts_agu_index = (instruction_slot == 0) ? evts_instr._port
                                                    : evts_instr._port + 2;
    logic [$clog2(NUM_AGUS)-1:0] evtx_agu_index;
    assign evtx_agu_index = (instruction_slot == 0) ? evtx_instr._port
                                                    : evtx_instr._port + 2;
    always_ff @(posedge clk or negedge rst_n) begin
      if (~rst_n) begin
        for (int j = 0; j < NUM_AGUS; j++) begin
          for (int t = 0; t < NDIM; t++) begin
            agu_stride[j][t] <= '0;
            agu_level[j][t]  <= '0;
          end
          agu_nterm[j] <= '0;
          agu_init_high[j] <= '0;
        end
      end else if (evt_valid) begin
        agu_stride[evt_agu_index][0] <= evt_instr._stride;
        agu_level[evt_agu_index][0]  <= evt_instr._loop_level;
        for (int t = 1; t < NDIM; t++) begin
          agu_stride[evt_agu_index][t] <= '0;
          agu_level[evt_agu_index][t]  <= '0;
        end
        agu_nterm[evt_agu_index] <= 1;
      end else if (evts_valid) begin
        agu_stride[evts_agu_index][agu_nterm[evts_agu_index]] <= evts_instr._stride;
        agu_level[evts_agu_index][agu_nterm[evts_agu_index]]  <= evts_instr._loop_level;
        agu_nterm[evts_agu_index] <= agu_nterm[evts_agu_index] + 1;
      end else if (evtx_valid) begin
        agu_init_high[evtx_agu_index] <= evtx_instr._init_addr_high;
      end
    end

    // Sample the selected loop counters when an AGU is activated; hold them for
    // the whole run so every address in this activation uses the same offset.
    always_ff @(posedge clk or negedge rst_n) begin
      if (~rst_n) begin
        for (int j = 0; j < NUM_AGUS; j++) begin
          for (int t = 0; t < NDIM; t++) begin
            loop_var_q[j][t] <= '0;
          end
        end
      end else begin
        for (int j = 0; j < NUM_AGUS; j++) begin
          if (agu_activate[j]) begin
            for (int t = 0; t < NDIM; t++) begin
              loop_var_q[j][t] <= loop_var_bus[agu_level[j][t]*LOOP_VAR_WIDTH +: LOOP_VAR_WIDTH];
            end
          end
        end
      end
    end

    agu_controller #(
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUM_AGUS(NUM_AGUS),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
      .EVT_INIT_ADDR_WIDTH(EVT_INIT_ADDR_BITWIDTH)
    ) controller_inst (
      .clk(clk),
      .rst_n(rst_n),

      // Dual instruction slots: slot>0 targets the upper AGU group (offset +2).
      .evt_valid(evt_valid),
      .evt_port((instruction_slot == 0) ? evt_instr._port : evt_instr._port + 2),
      .evt_init_addr(evt_instr._init_addr),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .agu_done(agu_done),
      .agu_configs(agu_configs),
      .init_address(agu_init_address)
    );

    genvar i;
    generate
      for (i = 0; i < NUM_AGUS; i++) begin : gen_agu
        localparam int AGU_ADDR_WIDTH = (i == 0 || i == 1) ? IO_ADDR_WIDTH : SRAM_ADDR_WIDTH;
        logic [AGU_ADDR_WIDTH-1:0] agu_addr_inner;
        agu_rtr #(
          .ADDRESS_WIDTH(AGU_ADDR_WIDTH),
          .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
          .REP_ITER_WIDTH(REP_ITER_WIDTH),
          .REP_STEP_WIDTH(REP_STEP_WIDTH),
          .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH),
          .NUMBER_OR(NUMBER_OR),
          .NUMBER_MT(NUMBER_MT),
          .NUMBER_IR(NUMBER_IR)
        ) agu_inst (
          .clk(clk),
          .rst_n(rst_n),
          .enable(1'b1),
          .activation(agu_activate[i]),
          .cfg(agu_configs[i]),
          .addr_valid(agu_valid[i]),
          .addr(agu_addr_inner),
          .done(agu_done[i])
        );
        assign agu_address[i] = ADDRESS_WIDTH'(agu_addr_inner);
      end
    endgenerate

    // merge the IO writing and normal writing to SRAM, IO has higher priority.
    // merge the writing and reading, writing has higher priority.
    logic [SRAM_ADDR_WIDTH-1:0] sram_in_addr;
    logic sram_in_en;
    logic [BULK_BITWIDTH-1:0] sram_in_data;
    logic [SRAM_ADDR_WIDTH-1:0] sram_out_addr;
    logic sram_out_en;
    logic [BULK_BITWIDTH-1:0] sram_out_data;
    logic [SRAM_ADDR_WIDTH-1:0] sram_addr;
    logic sram_write_en;

    // input ports
    always_comb begin
        // SRAM IN (AGU 2 - SLOT 0 PORT 2)
        if (agu_valid[2]) begin
            sram_in_en = 1;
            sram_in_addr = agu_final_address[2];
            sram_in_data = io_data_in;
        end
        // BULK IN (AGU 4 - SLOT 1 PORT 2)
        else if (agu_valid[4]) begin
            sram_in_en = 1;
            sram_in_addr = agu_final_address[4];
            sram_in_data = bulk_data_in_1;
        end
        else begin
            sram_in_en = 0;
            sram_in_addr = 0;
            sram_in_data = 0;
        end
    end

    // output ports
    always_comb begin
        // SRAM OUT (AGU 3 - SLOT 0 PORT 3)
        if (agu_valid[3]) begin
            sram_out_en = 1;
            sram_out_addr = agu_final_address[3];
            io_data_out = sram_out_data;
            bulk_data_out_1 = 0;
        end
        // BULK OUT (AGU 5 - SLOT 1 PORT 3)
        else if (agu_valid[5]) begin
            sram_out_en = 1;
            sram_out_addr = agu_final_address[5];
            io_data_out = 0;
            bulk_data_out_1 = sram_out_data;
        end
        else begin
            sram_out_en = 0;
            sram_out_addr = 0;
            io_data_out = 0;
            bulk_data_out_1 = 0;
        end
    end

    // IO IN (AGU 0 - SLOT 0 PORT 0)
    assign io_en_in = agu_valid[0];
    assign io_addr_in = agu_final_address[0];

    // IO OUT (AGU 1 - SLOT 0 PORT 1)
    assign io_en_out = agu_valid[1];
    assign io_addr_out = agu_final_address[1];

    sram #(
        .DEPTH(DEPTH),
        .WIDTH(WIDTH)
    ) sram_inst (
        .clk(clk),
        .enable_a_n(~sram_in_en),
        .enable_b_n(~sram_out_en),
        .write_enable_a_n(~sram_in_en),
        .write_enable_b_n(1'b1),
        .address_a(sram_in_addr),
        .address_b(sram_out_addr),
        .data_a(sram_in_data),
        .data_b('0),
        .q_a(),
        .q_b(sram_out_data)
    );
endmodule

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
