// vesyla_template_start defines
`define {{name}} {{name}}_{{fingerprint}}
`define {{name}}_pkg {{name}}_{{fingerprint}}_pkg
// vesyla_template_end defines

// vesyla_template_start module_head
{% if not already_defined %}
module {{name}}_{{fingerprint}}
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
    input  logic clk_0,
    input  logic rst_n_0,
    input  logic instr_en_0,
    input  logic [RESOURCE_INSTR_WIDTH-1:0] instr_0,
    input  logic [FSM_PER_SLOT-1:0] activate_0,
    input logic [NUM_SLOTS-1:0][WORD_BITWIDTH-1:0] word_channels_in,
    output logic [NUM_SLOTS-1:0][WORD_BITWIDTH-1:0] word_channels_out,
    input logic [NUM_SLOTS-1:0][BULK_BITWIDTH-1:0] bulk_intracell_in,
    output logic [NUM_SLOTS-1:0][BULK_BITWIDTH-1:0] bulk_intracell_out,
    input logic [BULK_BITWIDTH-1:0] bulk_intercell_n_in,
    input logic [BULK_BITWIDTH-1:0] bulk_intercell_w_in,
    input logic [BULK_BITWIDTH-1:0] bulk_intercell_e_in,
    input logic [BULK_BITWIDTH-1:0] bulk_intercell_s_in,
    output logic [BULK_BITWIDTH-1:0] bulk_intercell_n_out,
    output logic [BULK_BITWIDTH-1:0] bulk_intercell_w_out,
    output logic [BULK_BITWIDTH-1:0] bulk_intercell_e_out,
    output logic [BULK_BITWIDTH-1:0] bulk_intercell_s_out
);

    logic clk, rst_n;
    assign clk = clk_0;
    assign rst_n = rst_n_0;

    // Instruction decoding signals
    logic instruction_valid;
    logic [INSTR_PAYLOAD_BITWIDTH-1:0] instruction_payload;
    assign instruction_valid = instr_en_0;
    assign instruction_payload = instr_0[INSTR_PAYLOAD_BITWIDTH-1:0];

    // SWB and ROUTE configuration signals
    logic swb_conf_valid, route_in_conf_valid, route_out_conf_valid;
    logic [$clog2(NUM_OPTIONS)-1:0] option_index;
    logic [$clog2(NUM_SLOTS)-1:0] swb_conf_link;
    logic [$clog2(NUM_DIRS)-1:0]  route_in_conf_link;
    logic [$clog2(NUM_SLOTS)-1:0] route_out_conf_link;

    // Configuration write data from the controller
    logic [$clog2(NUM_SLOTS)-1:0] swb_conf_data;
    logic [NUM_SLOTS-1:0]         route_in_conf_data;
    logic [NUM_DIRS-1:0]          route_out_conf_data;

    // Live configuration for the option each AGU currently addresses
    logic [NUM_SLOTS-1:0][$clog2(NUM_SLOTS)-1:0] curr_swb_config;
    logic [NUM_DIRS-1:0][NUM_SLOTS-1:0]          curr_route_in_config;
    logic [NUM_SLOTS-1:0][NUM_DIRS-1:0]          curr_route_out_config;

    // AGU control signals
    // NOTE: The switchbox only uses 2 AGUs (1 for SWB and 1 for ROUTE)
    logic [NUM_AGUS-1:0] agu_enable;
    logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address;

    // Decoded instruction signals
    logic   evt_valid;
    evt_t   evt_instr;
    logic   swb_valid;
    swb_t   swb_instr;
    logic   route_valid;
    route_t route_instr;
    logic   rep_valid;
    rep_t   rep_instr;
    logic   trans_valid;
    trans_t trans_instr;

    // Decoder module
    {{name}}_{{fingerprint}}_decoder decoder_inst (
      .clk(clk),
      .rst_n(rst_n),
      .instruction_valid(instruction_valid),
      .instruction_payload(instruction_payload),
      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .swb_valid(swb_valid),
      .swb_instr(swb_instr),
      .route_valid(route_valid),
      .route_instr(route_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr)
    );

    // Controller module
    {{name}}_{{fingerprint}}_controller controller_inst (
      .clk(clk),
      .rst_n(rst_n),

      .evt_valid(evt_valid),
      .evt_instr(evt_instr),
      .swb_valid(swb_valid),
      .swb_instr(swb_instr),
      .route_valid(route_valid),
      .route_instr(route_instr),
      .rep_valid(rep_valid),
      .rep_instr(rep_instr),
      .trans_valid(trans_valid),
      .trans_instr(trans_instr),

      .swb_conf_valid(swb_conf_valid),
      .route_in_conf_valid(route_in_conf_valid),
      .route_out_conf_valid(route_out_conf_valid),
      .option_index(option_index),
      .swb_conf_link(swb_conf_link),
      .route_in_conf_link(route_in_conf_link),
      .route_out_conf_link(route_out_conf_link),

      .swb_conf_data(swb_conf_data),
      .route_in_conf_data(route_in_conf_data),
      .route_out_conf_data(route_out_conf_data)
    );

    // Configuration registers (lib/common/config_controller). Three banks, one
    // per configurable structure; each holds NUM_OPTIONS configurations and the
    // owning AGU's address selects which is live. The switchbox reads the
    // option latched at the last address strobe, so BYPASS_ON_VALID stays 0.
    config_controller #(
      .NUM_OPTIONS(NUM_OPTIONS),
      .REGS_PER_OPTION(NUM_SLOTS),
      .REG_WIDTH($clog2(NUM_SLOTS)),
      .SELECT_WIDTH(ADDRESS_WIDTH)
    ) swb_config_inst (
      .clk  (clk),
      .rst_n(rst_n),
      .write_valid  (swb_conf_valid),
      .write_option (option_index),
      .write_reg    (swb_conf_link),
      .write_data   (swb_conf_data),
      .select_valid (agu_enable[AGU_SWB_INDEX]),
      .select_option(agu_address[AGU_SWB_INDEX]),
      .current      (curr_swb_config)
    );

    config_controller #(
      .NUM_OPTIONS(NUM_OPTIONS),
      .REGS_PER_OPTION(NUM_DIRS),
      .REG_WIDTH(NUM_SLOTS),
      .SELECT_WIDTH(ADDRESS_WIDTH)
    ) route_in_config_inst (
      .clk  (clk),
      .rst_n(rst_n),
      .write_valid  (route_in_conf_valid),
      .write_option (option_index),
      .write_reg    (route_in_conf_link),
      .write_data   (route_in_conf_data),
      .select_valid (agu_enable[AGU_ROUTE_INDEX]),
      .select_option(agu_address[AGU_ROUTE_INDEX]),
      .current      (curr_route_in_config)
    );

    config_controller #(
      .NUM_OPTIONS(NUM_OPTIONS),
      .REGS_PER_OPTION(NUM_SLOTS),
      .REG_WIDTH(NUM_DIRS),
      .SELECT_WIDTH(ADDRESS_WIDTH)
    ) route_out_config_inst (
      .clk  (clk),
      .rst_n(rst_n),
      .write_valid  (route_out_conf_valid),
      .write_option (option_index),
      .write_reg    (route_out_conf_link),
      .write_data   (route_out_conf_data),
      .select_valid (agu_enable[AGU_ROUTE_INDEX]),
      .select_option(agu_address[AGU_ROUTE_INDEX]),
      .current      (curr_route_out_config)
    );

    // Shared AGU subsystem (lib/common/agu_array): controller + one agu_rtr
    // per port. The switchbox's AGUs are uniform and all present, and it has
    // no init-address path, so evt_init_addr is tied off.
    agu_array #(
      .NUM_AGUS(NUM_AGUS),
      .ADDRESS_WIDTH(ADDRESS_WIDTH),
      .NUMBER_IR(NUMBER_IR),
      .NUMBER_MT(NUMBER_MT),
      .NUMBER_OR(NUMBER_OR),
      .REP_DELAY_WIDTH(REP_DELAY_WIDTH),
      .REP_ITER_WIDTH(REP_ITER_WIDTH),
      .REP_STEP_WIDTH(REP_STEP_WIDTH),
      .TRANS_DELAY_WIDTH(TRANS_DELAY_WIDTH)
    ) agu_array_inst (
      .clk(clk),
      .rst_n(rst_n),

      .evt_valid(evt_valid),
      .evt_port(evt_instr._port),
      .evt_init_addr('0),

      .rep_valid(rep_valid),
      .rep_ext(rep_instr._ext),
      .rep_delay(rep_instr._delay),
      .rep_iter(rep_instr._iter),
      .rep_step(rep_instr._step),

      .trans_valid(trans_valid),
      .trans_delay(trans_instr._delay),

      .activation(activate_0[NUM_AGUS-1:0]),
      .addr_valid(agu_enable),
      .addr(agu_address),
      .done(),
      .is_configured()
    );

    // SWB word channel routing logic
    always_comb
      for (int i=0; i < NUM_SLOTS; i++)
        word_channels_out[curr_swb_config[i]] = word_channels_in[i];

    logic [BULK_BITWIDTH-1:0] bulk_local_channel;

    // ROUTE send links
    always_comb begin
      // Default assignments
      bulk_intercell_n_out = '0;
      bulk_intercell_w_out = '0;
      bulk_local_channel   = '0;
      bulk_intercell_e_out = '0;
      bulk_intercell_s_out = '0;

      for (int i = 0; i < NUM_SLOTS; i++) begin
        if (curr_route_out_config[i][DIR_NORTH])
          bulk_intercell_n_out = bulk_intracell_in[i];
        if (curr_route_out_config[i][DIR_WEST])
          bulk_intercell_w_out = bulk_intracell_in[i];
        if (curr_route_out_config[i][DIR_LOCAL])
          bulk_local_channel = bulk_intracell_in[i];
        if (curr_route_out_config[i][DIR_EAST])
          bulk_intercell_e_out = bulk_intracell_in[i];
        if (curr_route_out_config[i][DIR_SOUTH])
          bulk_intercell_s_out = bulk_intracell_in[i];
      end
    end

    // ROUTE receive links
    always_comb begin
      for (int i = 0; i < NUM_SLOTS; i++)
        bulk_intracell_out[i] = '0; // Default assignment

      for (int d = 0; d < NUM_DIRS; d++) begin
        for (int i = 0; i < NUM_SLOTS; i++) begin
          if (curr_route_in_config[d][i]) begin
            case (d)
              DIR_NORTH: bulk_intracell_out[i] = bulk_intercell_n_in;
              DIR_WEST:  bulk_intracell_out[i] = bulk_intercell_w_in;
              DIR_LOCAL: bulk_intracell_out[i] = bulk_local_channel;
              DIR_EAST:  bulk_intracell_out[i] = bulk_intercell_e_in;
              DIR_SOUTH: bulk_intracell_out[i] = bulk_intercell_s_in;
              default:   bulk_intracell_out[i] = '0; // Unsupported directions
            endcase
          end
        end
      end
    end
endmodule

// vesyla_template_start module_tail
{% endif %}
// vesyla_template_end module_tail
