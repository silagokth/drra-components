// vesyla_template_start package_head
package {{name}}_{{fingerprint}}_pkg;
// vesyla_template_end package_head

  // vesyla_template_start package_macro
  {% include "package.j2" %}
  // vesyla_template_end package_macro

  import agu_rtr_pkg::*;

  // NUM_OPTIONS, the options in the configuration table, comes from arch.json
  // (emitted by package.j2 above; vesyla defaults it to 4). A CONF can name
  // the first 8, its option field being 3 bits; more are for a fabric without
  // reconfiguration, whose options are hardcoded.
  parameter int FSM_DELAY_WIDTH = 3;
  parameter int NUM_AGUS = 2;
  parameter int AGU_SWB_INDEX = 0;
  parameter int AGU_SWB_PORTNUM = 0;
  parameter int AGU_ROUTE_INDEX = 1;
  parameter int AGU_ROUTE_PORTNUM = 2;

  parameter int NUM_DIRS = 9;
  parameter int DIR_NORTH_WEST = 0; // NOTE: not supported
  parameter int DIR_NORTH      = 1;
  parameter int DIR_NORTH_EAST = 2; // NOTE: not supported
  parameter int DIR_WEST       = 3;
  parameter int DIR_LOCAL      = 4;
  parameter int DIR_EAST       = 5;
  parameter int DIR_SOUTH_WEST = 6; // NOTE: not supported
  parameter int DIR_SOUTH      = 7;
  parameter int DIR_SOUTH_EAST = 8; // NOTE: not supported

  // AGU RTR params
  parameter int ADDRESS_WIDTH = (NUM_OPTIONS > 1) ? $clog2(NUM_OPTIONS) : 1;
  parameter int REP_OPTION_WIDTH = $clog2(NUM_OPTIONS);
  parameter int REP_STEP_WIDTH = ADDRESS_WIDTH;
  // NUMBER_IR/MT/OR, REP_ITER_WIDTH, REP_DELAY_WIDTH and TRANS_DELAY_WIDTH come
  // from this resource's arch.json custom_properties (emitted by package.j2).
  parameter int NUM_LEVELS = NUMBER_IR + NUMBER_OR;
  parameter int INCLUDE_IR_STATES = 1;
  parameter int INCLUDE_MT_STATES = 1;
  parameter int INCLUDE_OR_STATES = 1;

  {% include "agu_config.j2" %}

  typedef struct {
    // Indexed by TARGET channel, holds the driving SOURCE slot. Target-keyed so a
    // later conf for a channel REPLACES its driver (last-write-wins, matching the
    // `channel == target` pasm contract). Source-keying let a stale entry from an
    // earlier epoch keep driving a channel, and the mux then resolved the clash by
    // source index rather than by which conf was written last.
    logic [$clog2(NUM_SLOTS)-1:0] slot_link [NUM_SLOTS];
    logic [NUM_SLOTS-1:0]         link_valid;  // per-target: channel has a driver
  } swb_config_t;

  typedef struct {
    logic [NUM_SLOTS-1:0] receive_links [NUM_DIRS];
  } route_receive_config_t;

  // A send conf as decoded: the directions a slot sends to.
  typedef struct {
    logic [NUM_DIRS-1:0] send_links [NUM_SLOTS];
  } route_send_config_t;

  // Stored send routes. Indexed by DIRECTION, holds the sending SOURCE slot, so
  // a later send conf for a direction replaces its sender (like swb_config_t).
  // Source-keying let a stale sender from an earlier epoch keep driving a
  // direction, and the mux then picked the highest slot.
  typedef struct {
    logic [$clog2(NUM_SLOTS)-1:0] send_source [NUM_DIRS];
    logic [NUM_DIRS-1:0]          send_valid;
  } route_send_reg_t;

endpackage

