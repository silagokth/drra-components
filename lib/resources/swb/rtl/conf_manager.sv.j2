// vesyla_template_start module_head
module {{name}}_{{fingerprint}}_conf_manager
import {{name}}_{{fingerprint}}_pkg::*;
// vesyla_template_end module_head
(
  input logic clk,
  input logic rst_n,

  // AGU address interface
  input logic [NUM_AGUS-1:0] agu_enable,
  input logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] agu_address,
  input logic [NUM_AGUS-1:0] agu_is_configured,
  input logic [NUM_AGUS-1:0] agu_done,

  // SWB and ROUTE selection
  input logic swb_conf_valid,
  input logic route_in_conf_valid,
  input logic route_out_conf_valid,
  input logic [$clog2(NUM_CONFIGS)-1:0] option_index,

  // SWB and ROUTE link indices to configure
  input logic [$clog2(NUM_SLOTS)-1:0] swb_conf_link,
  input logic [$clog2(NUM_DIRS)-1:0]  route_in_conf_link,
  input logic [$clog2(NUM_SLOTS)-1:0] route_out_conf_link,

  // SWB and ROUTE configurations
  input swb_config_t swb_configs [NUM_CONFIGS],
  input route_receive_config_t route_in_configs [NUM_CONFIGS],
  input route_send_config_t    route_out_configs [NUM_CONFIGS],

  // Output current configurations
  output swb_config_t current_swb_config,
  output route_receive_config_t current_route_in_config,
  output route_send_config_t    current_route_out_config
);

  // Signal to hold current option index (renamed for clarity)
  logic [NUM_AGUS-1:0] option_valid;
  logic [NUM_AGUS-1:0][ADDRESS_WIDTH-1:0] current_option;
  always_ff @(posedge clk or negedge rst_n) begin
    // Default to not valid
    if (!rst_n) begin
      option_valid <= '0;
      current_option <= '0;
    end else begin
      for (int i = 0; i < NUM_AGUS; i++) begin
        if (agu_enable[i]) begin
          option_valid[i] <= 1'b1;
          current_option[i] <= agu_address[i];
        end else begin
          option_valid[i] <= 1'b1;
          current_option[i] <= current_option[i];
        end
      end
    end
  end

  // Signals to hold all configurations
  swb_config_t swb_config_reg [NUM_CONFIGS];
  route_receive_config_t route_in_config_reg [NUM_CONFIGS];
  route_send_config_t    route_out_config_reg [NUM_CONFIGS];

  // Per-option "touched-this-epoch" flags. An option holds a *complete* crossbar
  // / route snapshot, but each swb/route instruction only writes one link entry.
  // Re-using an option in a later epoch must REPLACE it, not merge new links onto
  // the stale ones. So the first write to an option after its selecting AGU has
  // finished (agu_done — the epoch boundary that already resets the AGU config in
  // the controller) clears the whole option first; later writes in the same epoch
  // accumulate. swb options are selected by AGU_SWB_INDEX, route options (both
  // in and out) by AGU_ROUTE_INDEX.
  logic swb_opt_touched   [NUM_CONFIGS];
  logic route_opt_touched [NUM_CONFIGS];

  // Update configurations on valid address
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      // Reset all configurations
      for (int i = 0; i < NUM_CONFIGS; i++) begin
        for (int j = 0; j < NUM_SLOTS; j++)
          swb_config_reg[i].slot_link[j] <= '{default: 0};
        for (int d = 0; d < NUM_DIRS; d++)
          route_in_config_reg[i].receive_links[d] <= '{default: 0};
        for (int s = 0; s < NUM_SLOTS; s++)
          route_out_config_reg[i].send_links[s] <= '{default: 0};
        swb_opt_touched[i]   <= 1'b0;
        route_opt_touched[i] <= 1'b0;
      end
    end else begin
      // Epoch boundary: when the selecting AGU finishes, mark every option stale
      // so its next configuration replaces (rather than merges with) the config
      // left over from this epoch.
      if (agu_done[AGU_SWB_INDEX])
        for (int i = 0; i < NUM_CONFIGS; i++)
          swb_opt_touched[i] <= 1'b0;
      if (agu_done[AGU_ROUTE_INDEX])
        for (int i = 0; i < NUM_CONFIGS; i++)
          route_opt_touched[i] <= 1'b0;

      // Register swb configuration. First write to this option this epoch wipes
      // the whole option; the addressed slot_link write below is later in source
      // order, so it wins for its index (nonblocking last-write-wins).
      if (swb_conf_valid) begin
        if (!swb_opt_touched[option_index]) begin
          for (int j = 0; j < NUM_SLOTS; j++)
            swb_config_reg[option_index].slot_link[j] <= '{default: 0};
          swb_opt_touched[option_index] <= 1'b1;
        end
        swb_config_reg[option_index].slot_link[swb_conf_link] <=
          swb_configs[option_index].slot_link[swb_conf_link];
      end

      // Register route configuration. Send and receive share one per-option flag:
      // the first route write of either kind wipes the whole option (both the
      // receive and the send links) before the addressed links are applied below.
      if (route_in_conf_valid || route_out_conf_valid) begin
        if (!route_opt_touched[option_index]) begin
          for (int d = 0; d < NUM_DIRS; d++)
            route_in_config_reg[option_index].receive_links[d] <= '{default: 0};
          for (int s = 0; s < NUM_SLOTS; s++)
            route_out_config_reg[option_index].send_links[s] <= '{default: 0};
          route_opt_touched[option_index] <= 1'b1;
        end
      end

      // Register route in configurations if valid else hold previous value
      if (route_in_conf_valid)
        route_in_config_reg[option_index].receive_links[route_in_conf_link] <=
          route_in_configs[option_index].receive_links[route_in_conf_link];

      // Register route out configurations if valid else hold previous value
      if (route_out_conf_valid)
        route_out_config_reg[option_index].send_links[route_out_conf_link] <=
          route_out_configs[option_index].send_links[route_out_conf_link];
    end
  end

  // Assign current configurations based on current option
  always_comb begin
    current_swb_config        = '{default: 0};
    current_route_in_config   = '{default: 0};
    current_route_out_config  = '{default: 0};

    if (option_valid[AGU_SWB_INDEX] && current_option[AGU_SWB_INDEX] < NUM_CONFIGS)
      current_swb_config        = swb_config_reg[current_option[AGU_SWB_INDEX]];
    if (option_valid[AGU_ROUTE_INDEX] && current_option[AGU_ROUTE_INDEX] < NUM_CONFIGS) begin
      current_route_in_config   = route_in_config_reg[current_option[AGU_ROUTE_INDEX]];
      current_route_out_config  = route_out_config_reg[current_option[AGU_ROUTE_INDEX]];
    end
  end

endmodule

